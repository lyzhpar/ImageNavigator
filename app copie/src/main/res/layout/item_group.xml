<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

<TextView
    android:id="@+id/worldNameTextView"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:text="Nom du monde"
    android:textSize="14sp"
    android:textStyle=""
    android:ellipsize="end"
    android:maxLines="3"
    android:breakStrategy="simple"
    android:layout_marginEnd="8dp"
    android:textColor="#000000" />

    <EditText
        android:id="@+id/worldNameEditText"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:fontFamily="sans-serif-condensed"
        android:visibility="gone"
        android:singleLine="true"
        android:imeOptions="actionDone" />

    <ImageView
        android:id="@+id/deleteGroupIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_delete"
        android:visibility="gone"
        android:contentDescription="Supprimer le groupe" />



    <ImageView
        android:id="@+id/arrowIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_down"
        android:contentDescription="@string/expand_collapse_icon"
        android:layout_marginStart="8dp" />
</LinearLayout>