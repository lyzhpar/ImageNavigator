            <solid android:color="#3399FF"/>
            <corners android:radius="32dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#66B2FF"/>
            <corners android:radius="32dp"/>
        </shape>
    </item>
</selector>