<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Bandeau vertical sur la gauche -->
    <!-- 🟦 Barre latérale gauche (sidebarLeft)
         - Pour modifier sa largeur, change `layout_width`
         - Pour changer l’alignement, modifie `layout_constraintStart_toStartOf`
         - ⬅️ Pour l'instant elle est Collée au bord gauche
    -->
    <ScrollView
        android:id="@+id/sidebarLeft"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:background="#EEEEEE"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/imageListVertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <!-- Zone de dessin -->
    <!-- 🟥 Zone de dessin (drawingView)
         - Elle s’adapte à l’espace entre la barre latérale et le bord droit
         - Largeur dynamique : `layout_width="0dp"` + contraintes de `Start_toEnd` et `End_toEnd`
    -->
    <com.example.imagenavigator.screens.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="#22FF0000"
        app:layout_constraintStart_toEndOf="@id/sidebarLeft"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Barre d'action -->
    <!-- 🟨 Barre d’actions en bas à droite
         - Positionnée avec `constraintBottom_toBottomOf` et `constraintEnd_toEndOf`
    -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/resetButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_reset"
            android:contentDescription="Effacer les zones" />

        <ImageButton
            android:id="@+id/saveButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_save"
            android:contentDescription="Sauvegarder la configuration" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>