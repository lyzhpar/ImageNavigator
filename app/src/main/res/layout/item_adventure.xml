<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardBackgroundColor="#E0E0E0"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="5dp">

    <FrameLayout
        android:id="@+id/adventureCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/adventure_card_background"
        android:backgroundTint="@color/colorPrimary"
        android:clickable="false"
        android:focusable="false">


        <!-- Nom de l'aventure -->
        <TextView
            android:id="@+id/adventureName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="Nom aventure"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Overlay avec les 3 boutons -->
        <LinearLayout
            android:id="@+id/overlayContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D9D9D9"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="11dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEdit"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:backgroundTint="?android:attr/textColorSecondaryNoDisable"
                android:textSize="18sp"
                android:text="Modifier"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRename"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:backgroundTint="?android:attr/textColorSecondaryNoDisable"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="Renommer"
                app:cornerRadius="18dp"
                android:textColor="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDelete"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:backgroundTint="@color/colorAccent"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="Supprimer"
                app:cornerRadius="18dp"
                android:textColor="@android:color/white" />
        </LinearLayout>

    </FrameLayout>
</androidx.cardview.widget.CardView>