<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🟦 Sidebar -->
    <LinearLayout
        android:id="@+id/sidebarContainer"
        android:layout_width="250dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- En-tête aventure -->
        <LinearLayout
            android:id="@+id/headerAdventure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/adventureNameTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nom_aventure"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/buttonSaveAdventure"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_save"
                android:contentDescription="@string/save_adventure"
                app:tint="@color/black"
                android:scaleType="centerInside"
                android:adjustViewBounds="true" />

            <ImageButton
                android:id="@+id/buttonRenameAdventure"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit_save"
                app:tint="@color/black"
                android:contentDescription="@string/rename_adventure"
                android:scaleType="centerInside"
                android:adjustViewBounds="true" />
        </LinearLayout>

        <!-- Miniatures -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewThumbnails"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="4dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- 🟥 Zone de dessin -->
    <com.example.imagenavigator.screens.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#22FF0000"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toEndOf="@id/sidebarContainer"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 🟩 BottomBar -->
    <include
        android:id="@+id/bottomBar"
        layout="@layout/bottom_bar_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:viewBindingIgnore="false" />

    <!-- ⏳ ProgressBar -->
    <ProgressBar
        android:id="@+id/loadingOverlay"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:visibility="gone"
        android:indeterminate="true"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>