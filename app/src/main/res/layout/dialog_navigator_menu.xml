<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/outsideContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#AA000000"
    android:clickable="true"
    android:focusable="true">

<ScrollView
    android:id="@+id/menuContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/menu_background"
    android:elevation="8dp">

<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/buttonBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/button_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="COULEUR DE FOND"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/colorWhite"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/color_selector"
            android:tag="#FFFFFF"
            android:contentDescription="Blanc"
            android:src="@android:color/white" />

        <ImageView
            android:id="@+id/colorGrey"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/color_selector"
            android:tag="#F0F0F0"
            android:contentDescription="Gris"
            android:src="@android:color/darker_gray" />

        <ImageView
            android:id="@+id/colorBlack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/color_selector"
            android:tag="#000000"
            android:contentDescription="Noir"
            android:src="@android:color/black" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonTransition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transitions"
        android:background="@drawable/button_background"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/buttonEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Éditer l’aventure"
        android:background="@drawable/button_background"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/buttonStartImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Image de départ"
        android:background="@drawable/button_background"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/buttonReturnMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Menu des Aventures"
        android:background="@drawable/button_background"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/buttonToggleZones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Afficher/Masquer les zones"
        android:background="@drawable/button_background"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:padding="12dp"
        android:layout_marginBottom="8dp" />
</LinearLayout>
</ScrollView>
    </FrameLayout>